#!/bin/sh
#
# Refuse to push anything except main.
#
# WHY: this repo has drifted into a stale-main / real-work-on-a-side-branch state three times.
# Each time it meant deploys needed a hand-copied commit reference, and each time it took a day to
# reconcile. As of 2026-08-12 there is exactly one branch and it is the deployed one. This hook
# makes that structural rather than a thing to remember.
#
# Activate once per clone:
#   git config core.hooksPath hooks
#
# Genuine exception (a real feature branch you intend to open a PR from):
#   git push --no-verify ...
# The flag is deliberate friction — if you are typing it by habit, the rule has stopped working.

ALLOWED="refs/heads/main"

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a ref pushes the null sha; let deletions through.
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  # Tags are fine — restore points are pushed as tags.
  case "$remote_ref" in refs/tags/*) continue ;; esac

  if [ "$remote_ref" != "$ALLOWED" ]; then
    echo ""
    echo "  ✗ push refused — this repo has one branch: main"
    echo ""
    echo "    you tried to push:  ${remote_ref#refs/heads/}"
    echo ""
    echo "    Put the work on main:"
    echo "      git switch main && git merge <your-branch> && git push"
    echo ""
    echo "    If you genuinely need a branch:  git push --no-verify"
    echo ""
    blocked=1
  fi
done

exit $blocked
