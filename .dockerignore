/.git
/node_modules
.dockerignore
.env
Dockerfile
fly.toml

# Non-runtime junk (excluded so the Docker build context stays clean).
# apps/metafield-manager is a SEPARATE Shopify app whose pnpm node_modules symlinks
# break `archive/tar: unknown file mode` during the build context upload.
apps
.claude
**/__pycache__
~$*
**/~$*
*.patch
*.csv
*.xlsx

# EXCEPT the recon inputs — /api/recon reads these at runtime from /app/src/data/recon,
# and src/data/recon/_recon_store/ is the durable reconciliation ledger.
# Negations come last so they override the *.csv / *.xlsx excludes above.
!src/data/recon/
!src/data/recon/**
