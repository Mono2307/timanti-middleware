<style>
  @page { size: A4; margin: 0.5cm; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  @media print {
    body { padding: 5px !important; margin: 0; }
    .container { page-break-inside: avoid !important; }
    a { display: none !important; visibility: hidden !important; }
  }
  body { font-family: Arial, sans-serif; font-size: 9px; line-height: 1.35; padding: 10px; }
  .container { max-width: 800px; margin: 0 auto; border: 2px solid #000; padding: 0; }
  .copies-bar { display: grid; grid-template-columns: 1fr 1fr 1fr; text-align: right; border-bottom: 1px solid #000; font-size: 7px; font-style: italic; }
  .copies-bar span { padding: 3px 8px; border-left: 1px solid #000; }
  .copies-bar span:first-child { border-left: none; }
  .title-header { text-align: center; padding: 8px 14px; border-bottom: 2px solid #000; min-height: 65px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .logo { max-width: 130px; height: auto; margin-bottom: 3px; }
  .title-center h1 { font-size: 16px; font-weight: bold; margin: 0; }
  .title-center p { font-size: 7.5px; color: #555; margin: 2px 0 0 0; }
  .challan-meta { display: grid; grid-template-columns: 1fr 1fr 1fr; border-bottom: 1px solid #ccc; }
  .meta-cell { padding: 5px 8px; font-size: 7.5px; border-right: 1px solid #ccc; }
  .meta-cell:last-child { border-right: none; }
  .meta-cell strong { display: block; font-size: 7px; color: #555; margin-bottom: 1px; }
  .parties-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; border-bottom: 2px solid #000; border-top: 1px solid #ccc; }
  .party-block { padding: 6px 8px; font-size: 7px; line-height: 1.4; border-right: 1px solid #ccc; }
  .party-block:last-child { border-right: none; }
  .party-block h4 { font-size: 7.5px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; padding-bottom: 3px; border-bottom: 1px solid #ddd; }
  .purpose-block { padding: 5px 10px; font-size: 7.5px; border-bottom: 2px solid #000; background: #fffbe6; }
  table { width: 100%; border-collapse: collapse; }
  .items-table { font-size: 7.5px; }
  .items-table th { background-color: #f0f0f0; padding: 5px 4px; text-align: left; font-weight: bold; border: 1px solid #000; font-size: 7.5px; }
  .items-table td { padding: 5px 4px; border: 1px solid #000; vertical-align: top; }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .totals-row td { font-weight: normal; padding: 4px 5px; font-size: 7.5px; }
  .total-row td { font-weight: bold; font-size: 9px; background: #f9f9f9; }
  .amount-words { padding: 5px 10px; font-size: 7.5px; font-weight: bold; border-top: 2px solid #000; display: flex; justify-content: space-between; }
  .footer-note { padding: 5px 10px; font-size: 7px; color: #555; border-top: 1px solid #ccc; line-height: 1.4; }
  .sign-section { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid #000; min-height: 60px; }
  .sign-block { padding: 8px 10px; font-size: 7.5px; }
  .sign-block:first-child { border-right: 2px solid #000; }
  .sign-block strong { display: block; margin-bottom: 8px; }
</style>

{% comment %}
  ── Address lookup ──
  Consignor ("Bill From" + "Dispatch From") comes from custom.state_code.
  Consignee ("Delivered To")               comes from custom.delivery_code.
  Neither has a default. A challan that invents a party when its metafield is absent is a GST
  document asserting a movement that never happened — which is exactly what the retired
  MH-HQ → KA-HSR fallback did on every draft that had no store code set. Blank or unrecognised
  now prints a visible error where the party block would be, so it cannot leave the store.

  Matching is on the hyphen-stripped code, so "KA-HSR", "KAHSR" and "ka hsr" all resolve. NOTE:
  the middleware does NOT normalise this way — its serial counter is keyed on the raw value, so
  "KAHSR" and "KA-HSR" would draw from two different counters. Staff must still type KA-HSR.
{% endcomment %}
{% assign from_code = order.metafields.custom.state_code    | strip | upcase %}
{% assign to_code   = order.metafields.custom.delivery_code | strip | upcase %}
{% assign from_key  = from_code | remove: "-" | remove: " " %}
{% assign to_key    = to_code   | remove: "-" | remove: " " %}

{% comment %}
  Ship Outside Codes: staff flag on the draft that says this movement goes to a customer, not to
  another store. When it is Yes the consignee is taken from the draft's own shipping (then
  billing) address and the typed delivery_code is ignored — staff can flip the toggle on a draft
  that already has a code, because the extension greys the field without clearing it.
  "true" is accepted alongside "yes" in case the field is ever migrated to a real boolean.
{% endcomment %}
{% assign ship_outside = order.metafields.custom.ship_outside_codes | strip | downcase %}
{% assign is_outside = false %}
{% if ship_outside == "yes" or ship_outside == "true" %}{% assign is_outside = true %}{% endif %}

{% if from_key == "MHHQ" %}
  {% assign from_entity   = "Auracarat Pvt Ltd" %}
  {% assign from_addr     = "C207 Crystal Plaza, New Link Road, Andheri (W), Mumbai – 400053 Maharashtra" %}
  {% assign from_dispatch = "AURACARAT PRIVATE LIMITED, 408, 1 Aerocity, Safed Pul, Saki Naka, Mumbai – 400072" %}
  {% assign from_gstin    = "27ABBCA3309B1ZB" %}
  {% assign from_state    = "27 Maharashtra" %}
  {% assign from_email    = "Shweta@timanti.in" %}
  {% assign from_phone    = "9820059416" %}
{% elsif from_key == "KAHSR" %}
  {% assign from_entity   = "Auracarat Private Limited (Karnataka)" %}
  {% assign from_addr     = "No.2634, Opp. Gnan Srishti School, Haralukunte Village, Begur Hobli, 17th Main HSR Layout 2nd Sector, Bengaluru 560102" %}
  {% assign from_dispatch = from_addr %}
  {% assign from_gstin    = "29ABBCA3309B1Z7" %}
  {% assign from_state    = "29 Karnataka" %}
  {% assign from_email    = "hsrstore@timanti.in" %}
  {% assign from_phone    = "9740465031" %}
{% else %}
  {% assign from_entity   = "⚠ NO CONSIGNOR — set custom.state_code on this draft" %}
  {% assign from_addr     = "" %}
  {% assign from_dispatch = "" %}
  {% assign from_gstin    = "—" %}
  {% assign from_state    = "—" %}
  {% assign from_email    = "" %}
  {% assign from_phone    = "" %}
{% endif %}

{% if is_outside %}
  {% assign _to = order.shipping_address %}
  {% if _to == blank %}{% assign _to = order.billing_address %}{% endif %}
  {% assign _pc = _to.province_code | strip | upcase %}
  {% if _pc == "JK" %}{% assign to_state = "01 Jammu & Kashmir" %}{% elsif _pc == "HP" %}{% assign to_state = "02 Himachal Pradesh" %}{% elsif _pc == "PB" %}{% assign to_state = "03 Punjab" %}{% elsif _pc == "CH" %}{% assign to_state = "04 Chandigarh" %}{% elsif _pc == "UK" %}{% assign to_state = "05 Uttarakhand" %}{% elsif _pc == "HR" %}{% assign to_state = "06 Haryana" %}{% elsif _pc == "DL" %}{% assign to_state = "07 Delhi" %}{% elsif _pc == "RJ" %}{% assign to_state = "08 Rajasthan" %}{% elsif _pc == "UP" %}{% assign to_state = "09 Uttar Pradesh" %}{% elsif _pc == "BR" %}{% assign to_state = "10 Bihar" %}{% elsif _pc == "SK" %}{% assign to_state = "11 Sikkim" %}{% elsif _pc == "AR" %}{% assign to_state = "12 Arunachal Pradesh" %}{% elsif _pc == "NL" %}{% assign to_state = "13 Nagaland" %}{% elsif _pc == "MN" %}{% assign to_state = "14 Manipur" %}{% elsif _pc == "MZ" %}{% assign to_state = "15 Mizoram" %}{% elsif _pc == "TR" %}{% assign to_state = "16 Tripura" %}{% elsif _pc == "ML" %}{% assign to_state = "17 Meghalaya" %}{% elsif _pc == "AS" %}{% assign to_state = "18 Assam" %}{% elsif _pc == "WB" %}{% assign to_state = "19 West Bengal" %}{% elsif _pc == "JH" %}{% assign to_state = "20 Jharkhand" %}{% elsif _pc == "OR" %}{% assign to_state = "21 Odisha" %}{% elsif _pc == "CT" %}{% assign to_state = "22 Chhattisgarh" %}{% elsif _pc == "MP" %}{% assign to_state = "23 Madhya Pradesh" %}{% elsif _pc == "GJ" %}{% assign to_state = "24 Gujarat" %}{% elsif _pc == "DN" or _pc == "DD" %}{% assign to_state = "26 Dadra & Nagar Haveli and Daman & Diu" %}{% elsif _pc == "MH" %}{% assign to_state = "27 Maharashtra" %}{% elsif _pc == "KA" %}{% assign to_state = "29 Karnataka" %}{% elsif _pc == "GA" %}{% assign to_state = "30 Goa" %}{% elsif _pc == "LD" %}{% assign to_state = "31 Lakshadweep" %}{% elsif _pc == "KL" %}{% assign to_state = "32 Kerala" %}{% elsif _pc == "TN" %}{% assign to_state = "33 Tamil Nadu" %}{% elsif _pc == "PY" %}{% assign to_state = "34 Puducherry" %}{% elsif _pc == "AN" %}{% assign to_state = "35 Andaman & Nicobar Islands" %}{% elsif _pc == "TG" %}{% assign to_state = "36 Telangana" %}{% elsif _pc == "AP" %}{% assign to_state = "37 Andhra Pradesh" %}{% elsif _pc == "LA" %}{% assign to_state = "38 Ladakh" %}{% else %}{% assign to_state = "" %}{% endif %}
  {% if _to == blank or to_state == blank %}
    {% assign to_entity = "⚠ NO CONSIGNEE — Ship Outside Codes is Yes but this draft has no usable customer address" %}
    {% assign to_addr  = "" %}
    {% assign to_state = "—" %}
    {% assign to_email = "" %}
    {% assign to_phone = "" %}
  {% else %}
    {% assign to_entity = _to.name %}
    {% capture to_addr %}{{ _to.address1 }}{% if _to.address2 != blank %}, {{ _to.address2 }}{% endif %}, {{ _to.city }}, {{ _to.province }}{% if _to.zip != blank %} - {{ _to.zip }}{% endif %}, {{ _to.country }}{% endcapture %}
    {% assign to_email = order.email %}
    {% assign to_phone = _to.phone %}
  {% endif %}
{% elsif to_key == "KAHSR" %}
  {% assign to_entity = "Auracarat Private Limited (Karnataka) — TIMANTI" %}
  {% assign to_addr   = "No.2634, Opp. Gnan Srishti School, Haralukunte Village, Begur Hobli, 17th Main HSR Layout 2nd Sector, Bengaluru 560102" %}
  {% assign to_gstin  = "29ABBCA3309B1Z7" %}
  {% assign to_state  = "29 Karnataka" %}
  {% assign to_email  = "hsrstore@timanti.in" %}
  {% assign to_phone  = "9740465031" %}
{% elsif to_key == "MHHQ" %}
  {% assign to_entity = "Auracarat Private Limited" %}
  {% assign to_addr   = "C207 Crystal Plaza, New Link Road, Andheri (W), Mumbai – 400053" %}
  {% assign to_gstin  = "27ABBCA3309B1ZB" %}
  {% assign to_state  = "27 Maharashtra" %}
  {% assign to_email  = "Shweta@timanti.in" %}
  {% assign to_phone  = "9820059416" %}
{% else %}
  {% assign to_entity = "⚠ NO CONSIGNEE — set custom.delivery_code on this draft" %}
  {% assign to_addr   = "" %}
  {% assign to_gstin  = "—" %}
  {% assign to_state  = "—" %}
  {% assign to_email  = "" %}
  {% assign to_phone  = "" %}
{% endif %}

{% assign inv_num = order.metafields.custom.serial_code %}{% if inv_num == blank %}{% assign inv_num = order.metafields.custom.serial_display %}{% endif %}{% if inv_num == blank %}{% assign inv_num = order.name %}{% endif %}
{% assign order_ref = order.metafields.custom.serial_no %}{% if order_ref == blank %}{% assign order_ref = order.name %}{% endif %}
{% assign inv_date  = order.created_at | date: "%d-%m-%Y" %}
{% if order.metafields.custom.invoice_date != blank %}{% assign inv_date = order.metafields.custom.invoice_date %}{% endif %}
{% assign transport_mode = order.metafields.custom.transport_mode | default: "BY AIR & ROAD" %}
{% assign vehicle_no     = order.metafields.custom.vehicle_no     | default: "—" %}
{% assign purpose        = order.metafields.custom.movement_purpose | default: "Goods are being moved for exhibition and display, to be returned to head office within 30 days. ON APPROVAL BASIS." %}

{% assign hsn_default = "71131914" %}
{% assign sno           = 0 %}
{% assign grand_qty     = 0 %}
{% assign grand_value   = 0 %}
{% assign grand_gross_g = 0 %}
{% assign grand_net_g   = 0 %}
{% assign grand_dia_c   = 0 %}
{% assign grand_gem_c   = 0 %}

{% comment %}
  ── Grouping key set: karat (SKU segment 3) × HSN (product.custom.hsn_code) ──
  Built from the data, not a fixed karat list, so an unexpected karat can never drop a line
  silently out of the totals. "@" delimits the key list on both ends of every entry so a
  `contains` probe can't partially match (e.g. "9~7113" inside "19~7113").
{% endcomment %}
{% assign group_keys = "@" %}
{% for li in order.line_items %}
  {% assign _sku = li.sku | split: "|" %}
  {% assign _kt  = _sku[2] | strip %}
  {% if _kt == blank %}{% assign _kt = "?" %}{% endif %}
  {% assign _hsn = li.product.metafields.custom.hsn_code | default: hsn_default %}
  {% assign _key   = _kt | append: "~" | append: _hsn %}
  {% assign _probe = "@" | append: _key | append: "@" %}
  {% unless group_keys contains _probe %}
    {% assign group_keys = group_keys | append: _key | append: "@" %}
  {% endunless %}
{% endfor %}
{% assign key_list = group_keys | split: "@" | sort %}

<div class="container">

  <div class="copies-bar">
    <span>Original for Consignee</span>
    <span>Duplicate for Transporter</span>
    <span>Triplicate for Consignor</span>
  </div>

  <div class="title-header">
    <img src="https://cdn.shopify.com/s/files/1/0775/8322/0993/files/Timanti_Logo_Black.jpg?v=1766506323" alt="Timanti Logo" class="logo">
    <div class="title-center">
      <h1>Delivery Challan</h1>
      <p>(U/S-31(1) of GST Act, 2017 read with Rule 1) &nbsp;|&nbsp; ON APPROVAL BASIS</p>
    </div>
  </div>

  <div class="challan-meta">
    <div class="meta-cell"><strong>Delivery Challan No.</strong>{{ inv_num }}</div>
    <div class="meta-cell"><strong>Challan Date</strong>{{ inv_date }}</div>
    <div class="meta-cell"><strong>Transportation Mode</strong>{{ transport_mode }}</div>
    <div class="meta-cell"><strong>State (From)</strong>{{ from_state }}</div>
    {% comment %}
      Place of Supply is the CONSIGNOR's state here, not the consignee's. The goods move on
      approval under s.31(7): no supply has occurred when the challan is raised, so the document
      states the state the goods are supplied FROM. Founder directive, 2026-09-15 — deliberate,
      do not "correct" it back to to_state.
    {% endcomment %}
    <div class="meta-cell"><strong>Place of Supply</strong>{{ from_state }}</div>
    <div class="meta-cell"><strong>Vehicle No.</strong>{{ vehicle_no }}</div>
  </div>

  <div class="parties-grid">
    <div class="party-block">
      <h4>Bill From (Consignor)</h4>
      <strong>{{ from_entity }}</strong><br>
      {{ from_addr }}<br>
      <strong>State Code:</strong> {{ from_state }}<br>
      <strong>GSTIN:</strong> {{ from_gstin }}<br>
      <strong>Email:</strong> {{ from_email }}<br>
      <strong>Phone:</strong> {{ from_phone }}
    </div>
    <div class="party-block">
      <h4>Consignee (Delivered To)</h4>
      <strong>{{ to_entity }}</strong><br>
      {{ to_addr }}<br>
      <strong>State Code:</strong> {{ to_state }}<br>
      {% unless is_outside %}<strong>GSTIN:</strong> {{ to_gstin }}<br>{% endunless %}
      <strong>Email:</strong> {{ to_email }}<br>
      <strong>Phone:</strong> {{ to_phone }}
    </div>
    <div class="party-block">
      <h4>Dispatch From</h4>
      <strong>AURACARAT PRIVATE LIMITED</strong><br>
      {{ from_dispatch }}<br>
      <strong>State Code:</strong> {{ from_state }}<br>
      <strong>GSTIN:</strong> {{ from_gstin }}<br>
      <strong>Email:</strong> {{ from_email }}<br>
      <strong>Phone:</strong> {{ from_phone }}
    </div>
  </div>

  <div class="purpose-block">
    <strong>Purpose of Movement:</strong> {{ purpose }}
  </div>

  <table class="items-table">
    <thead>
      <tr>
        <th style="width:5%;"  class="text-center">S.No.</th>
        <th style="width:27%;">Description of Goods</th>
        <th class="text-center" style="width:10%;">HSN of Goods</th>
        <th class="text-center" style="width:6%;">Qty</th>
        <th class="text-center" style="width:9%;">Gross Wt (g)</th>
        <th class="text-center" style="width:9%;">Net Wt (g)</th>
        <th class="text-center" style="width:9%;">Dia Wt (cts)</th>
        <th class="text-center" style="width:9%;">Gem Wt (cts)</th>
        <th class="text-right"  style="width:16%;">Taxable Value (₹)</th>
      </tr>
    </thead>
    <tbody>

      {% for _gkey in key_list %}
        {% if _gkey == blank %}{% continue %}{% endif %}
        {% assign _parts = _gkey | split: "~" %}
        {% assign g_kt  = _parts[0] %}
        {% assign g_hsn = _parts[1] %}

        {% assign g_qty=0 %}{% assign g_gross=0 %}{% assign g_net=0 %}{% assign g_dia=0 %}{% assign g_gem=0 %}{% assign g_value=0 %}

        {% for li in order.line_items %}
          {% assign _sku = li.sku | split: "|" %}
          {% assign _kt  = _sku[2] | strip %}
          {% if _kt == blank %}{% assign _kt = "?" %}{% endif %}
          {% unless _kt == g_kt %}{% continue %}{% endunless %}
          {% assign _hsn = li.product.metafields.custom.hsn_code | default: hsn_default %}
          {% unless _hsn == g_hsn %}{% continue %}{% endunless %}

          {% comment %}
            ── Physical: hidden line props first, catalog metafields as fallback ──
            EVERY source is PER PIECE, so every source is multiplied by li.quantity. The line
            properties were previously added unmultiplied while the Qty column summed quantity, so
            any line of qty 2 or more described a single piece: D219 printed 11.717 g gross for
            six pieces that weigh 23.434 g.

            Fallback order is dictated by what the print app can actually reach — only the first
            10 PINNED definitions of an owner type are exposed:
              gross     _gross_wt     → variant total_metal_weight_g (#5) → variant gross_weight_g (#7)
              net       _net_wt       → variant net_metal_weight_g (#6)
              diamond   _diamond_cts  → product totaldiamondweight (#4)
              gemstone  _gemstone_cts → product gemstone_weight (#5)
            Product net/total_metal_weight_g are UNPINNED, and there is no variant-level diamond or
            gemstone weight definition at all, so the stones have no variant fallback to offer.
          {% endcomment %}
          {% assign _gw=0 %}{% assign _nw=0 %}{% assign _dia=0 %}{% assign _gem=0 %}
          {% assign _gw_from_prop=false %}{% assign _nw_from_prop=false %}{% assign _dia_from_prop=false %}{% assign _gem_from_prop=false %}
          {% for p in li.properties %}
            {% if p.first == "_gross_wt"     %}{% assign _gw  = p.last | plus: 0 | times: li.quantity %}{% assign _gw_from_prop  = true %}{% endif %}
            {% if p.first == "_net_wt"       %}{% assign _nw  = p.last | plus: 0 | times: li.quantity %}{% assign _nw_from_prop  = true %}{% endif %}
            {% if p.first == "_diamond_cts"  %}{% assign _dia = p.last | plus: 0 | times: li.quantity %}{% assign _dia_from_prop = true %}{% endif %}
            {% if p.first == "_gemstone_cts" %}{% assign _gem = p.last | plus: 0 | times: li.quantity %}{% assign _gem_from_prop = true %}{% endif %}
          {% endfor %}
          {% unless _gw_from_prop %}
            {% if li.variant.metafields.custom.total_metal_weight_g %}{% assign _gw = li.variant.metafields.custom.total_metal_weight_g | plus: 0 | times: li.quantity %}
            {% elsif li.variant.metafields.custom.gross_weight_g    %}{% assign _gw = li.variant.metafields.custom.gross_weight_g       | plus: 0 | times: li.quantity %}{% endif %}
          {% endunless %}
          {% unless _nw_from_prop  %}{% if li.variant.metafields.custom.net_metal_weight_g %}{% assign _nw  = li.variant.metafields.custom.net_metal_weight_g | plus: 0 | times: li.quantity %}{% endif %}{% endunless %}
          {% unless _dia_from_prop %}{% if li.product.metafields.custom.totaldiamondweight %}{% assign _dia = li.product.metafields.custom.totaldiamondweight | plus: 0 | times: li.quantity %}{% endif %}{% endunless %}
          {% unless _gem_from_prop %}{% if li.product.metafields.custom.gemstone_weight    %}{% assign _gem = li.product.metafields.custom.gemstone_weight    | plus: 0 | times: li.quantity %}{% endif %}{% endunless %}

          {% comment %}
            Value = TAXABLE, the weighted reprice's own output. handleWeightedDocReprice computes
            (gold 100% + diamond 50% + making 100%), writes that as `Taxable Value`, then grosses
            it up by 1.03 into `Gross Value`. This challan states no tax, so it prints the
            pre-gross-up figure.
            Read `Taxable Value` rather than dividing `Gross Value` by 1.03: Gross Value is
            written PRE-discount and Taxable Value POST-discount, so the two diverge the moment a
            discount reaches one of these drafts.
            Fallback for a line the reprice never touched: the charged price, de-taxed.
          {% endcomment %}
          {% assign _tax_str="" %}
          {% for p in li.properties %}
            {% if p.first == "Taxable Value" %}{% assign _tax_str = p.last | remove: "Rs" | remove: "," | strip %}{% endif %}
          {% endfor %}
          {% if _tax_str != "" %}{% assign _val_p = _tax_str | times: 100 | round %}{% else %}{% assign _val_p = li.final_line_price | divided_by: 1.03 | round %}{% endif %}

          {% assign g_qty   = g_qty   | plus: li.quantity %}
          {% assign g_gross = g_gross | plus: _gw %}
          {% assign g_net   = g_net   | plus: _nw %}
          {% assign g_dia   = g_dia   | plus: _dia %}
          {% assign g_gem   = g_gem   | plus: _gem %}
          {% assign g_value = g_value | plus: _val_p %}
        {% endfor %}

        {% assign sno           = sno           | plus: 1 %}
        {% assign grand_qty     = grand_qty     | plus: g_qty %}
        {% assign grand_value   = grand_value   | plus: g_value %}
        {% assign grand_gross_g = grand_gross_g | plus: g_gross %}
        {% assign grand_net_g   = grand_net_g   | plus: g_net %}
        {% assign grand_dia_c   = grand_dia_c   | plus: g_dia %}
        {% assign grand_gem_c   = grand_gem_c   | plus: g_gem %}
        <tr>
          <td class="text-center">{{ sno }}.</td>
          <td>{% if g_kt == "?" %}Gold Jewellery <em>(karat not set in SKU)</em>{% else %}{{ g_kt }}Kt Gold Jewellery{% endif %}</td>
          <td class="text-center">{{ g_hsn }}</td>
          <td class="text-center">{{ g_qty }}</td>
          <td class="text-center">{{ g_gross | round: 3 }}</td>
          <td class="text-center">{{ g_net | round: 3 }}</td>
          <td class="text-center">{% if g_dia > 0 %}{{ g_dia | round: 3 }}{% else %}—{% endif %}</td>
          <td class="text-center">{% if g_gem > 0 %}{{ g_gem | round: 3 }}{% else %}—{% endif %}</td>
          <td class="text-right">{{ g_value | money_without_currency | remove: ',' }}</td>
        </tr>
      {% endfor %}

      <tr style="background:#f0f0f0; font-weight:bold;">
        <td colspan="3" class="text-right" style="font-size:8px; padding:4px 5px;">Total</td>
        <td class="text-center" style="font-size:8px;">{{ grand_qty }}</td>
        <td class="text-center" style="font-size:8px;">{{ grand_gross_g | round: 3 }}</td>
        <td class="text-center" style="font-size:8px;">{{ grand_net_g | round: 3 }}</td>
        <td class="text-center" style="font-size:8px;">{% if grand_dia_c > 0 %}{{ grand_dia_c | round: 3 }}{% else %}—{% endif %}</td>
        <td class="text-center" style="font-size:8px;">{% if grand_gem_c > 0 %}{{ grand_gem_c | round: 3 }}{% else %}—{% endif %}</td>
        <td class="text-right" style="font-size:8px;">{{ grand_value | money_without_currency | remove: ',' }}</td>
      </tr>
      <tr class="total-row">
        <td colspan="8" class="text-right"><strong>Total Taxable Value</strong></td>
        <td class="text-right"><strong>₹{{ grand_value | money_without_currency | remove: ',' }}</strong></td>
      </tr>
    </tbody>
  </table>

  <div class="amount-words">
    <span>
      {% assign ones = "Zero,One,Two,Three,Four,Five,Six,Seven,Eight,Nine,Ten,Eleven,Twelve,Thirteen,Fourteen,Fifteen,Sixteen,Seventeen,Eighteen,Nineteen" | split: "," %}
      {% assign tens = "Zero,Ten,Twenty,Thirty,Forty,Fifty,Sixty,Seventy,Eighty,Ninety" | split: "," %}
      {% assign total_int = grand_value | divided_by: 100 | floor %}{% assign words = "" %}
      {% assign crores = total_int | divided_by: 10000000 %}{% if crores > 0 %}{% assign temp = crores | modulo: 100 %}{% if temp < 20 %}{% assign words = words | append: ones[temp] | append: " " %}{% else %}{% assign td = temp | divided_by: 10 %}{% assign od = temp | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% assign words = words | append: " " %}{% endif %}{% assign words = words | append: "Crore " %}{% assign total_int = total_int | modulo: 10000000 %}{% endif %}
      {% assign lakhs = total_int | divided_by: 100000 %}{% if lakhs > 0 %}{% assign temp = lakhs | modulo: 100 %}{% if temp < 20 %}{% assign words = words | append: ones[temp] | append: " " %}{% else %}{% assign td = temp | divided_by: 10 %}{% assign od = temp | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% assign words = words | append: " " %}{% endif %}{% assign words = words | append: "Lakh " %}{% assign total_int = total_int | modulo: 100000 %}{% endif %}
      {% assign thousands = total_int | divided_by: 1000 %}{% if thousands > 0 %}{% assign temp = thousands | modulo: 100 %}{% if temp < 20 %}{% assign words = words | append: ones[temp] | append: " " %}{% else %}{% assign td = temp | divided_by: 10 %}{% assign od = temp | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% assign words = words | append: " " %}{% endif %}{% assign words = words | append: "Thousand " %}{% assign total_int = total_int | modulo: 1000 %}{% endif %}
      {% assign hundreds = total_int | divided_by: 100 %}{% if hundreds > 0 %}{% assign words = words | append: ones[hundreds] | append: " Hundred " %}{% assign total_int = total_int | modulo: 100 %}{% endif %}
      {% if total_int > 0 %}{% if total_int < 20 %}{% assign words = words | append: ones[total_int] %}{% else %}{% assign td = total_int | divided_by: 10 %}{% assign od = total_int | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% endif %}{% endif %}
      Total Taxable Value in Words: Rupees {{ words }} Only
    </span>
    <span>E. &amp; O. E.</span>
  </div>

  <div class="footer-note">
    No E-way Bill is required to be generated as the goods covered under this challan are exempted as per serial no. 4/5 to the annexure to Rule 138(14) of the CGST Rules, 2017. &nbsp;|&nbsp; Goods are being moved on approval basis and are to be returned if not accepted.
  </div>

