<style>
  @page { size: A4; margin: 0.5cm; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  @media print {
    body { padding: 5px !important; margin: 0; }
    .container { page-break-inside: avoid !important; }
    a { display: none !important; visibility: hidden !important; }
  }
  body { font-family: Arial, sans-serif; font-size: 8px; line-height: 1.2; padding: 10px; }
  .container { max-width: 800px; margin: 0 auto; border: 2px solid #000; padding: 0; }
  .header-text { text-align: right; padding: 3px 8px; font-size: 7px; font-style: italic; border-bottom: 1px solid #000; }
  .title-header { text-align: center; padding: 7px 10px; border-bottom: 2px solid #000; min-height: 60px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .logo { max-width: 120px; height: auto; margin-bottom: 4px; }
  .title-center h1 { font-size: 14px; font-weight: bold; margin: 0; }
  .company-invoice-grid { display: grid; grid-template-columns: 1.5fr 1fr; border-bottom: 2px solid #000; }
  .company-section { padding: 5px 8px; border-right: 2px solid #000; font-size: 7px; line-height: 1.35; }
  .company-section strong { font-size: 7.5px; }
  .invoice-details-grid { display: grid; grid-template-rows: repeat(3, 1fr); }
  .invoice-detail-row { display: grid; grid-template-columns: 1fr 1fr 1fr; border-bottom: 1px solid #000; }
  .invoice-detail-row:last-child { border-bottom: none; }
  .invoice-detail-cell { padding: 4px 6px; font-size: 7px; border-right: 1px solid #000; }
  .invoice-detail-cell:last-child { border-right: none; }
  .invoice-detail-cell strong { display: block; font-size: 7px; font-weight: bold; margin-bottom: 1px; }
  .addresses-section { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 2px solid #000; }
  .address-block { padding: 5px 8px; font-size: 7px; line-height: 1.3; }
  .address-block:first-child { border-right: 2px solid #000; }
  .address-block strong { display: block; margin-bottom: 1px; font-size: 7px; }
  .address-field { margin-bottom: 2px; }
  table { width: 100%; border-collapse: collapse; }
  .items-table { font-size: 6.5px; }
  .items-table th { background-color: #f0f0f0; padding: 3px 2px; text-align: left; font-weight: bold; border: 1px solid #000; font-size: 6.5px; line-height: 1.2; }
  .items-table td { padding: 3px 2px; border: 1px solid #000; vertical-align: top; }
  .items-table .text-right { text-align: right; }
  .items-table .text-center { text-align: center; }
  .totals-row td { font-weight: normal; padding: 3px 4px; font-size: 7px; }
  .total-row td { font-weight: bold; font-size: 8px; background-color: #f9f9f9; }
  .section-label-row td { font-weight: bold; font-size: 7px; color: #444; font-style: italic; padding: 2px 4px; }
  .amount-words { padding: 4px 8px; font-size: 7px; font-weight: bold; border-top: 2px solid #000; display: flex; justify-content: space-between; }
  .footer-section { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid #000; font-size: 6.5px; line-height: 1.25; }
  .footer-left { padding: 6px 8px; border-right: 2px solid #000; }
  .footer-right { padding: 6px 8px; }
  .footer-left h3, .footer-right h3 { font-size: 7px; margin-bottom: 3px; font-weight: bold; }
  .footer-left p, .footer-right p { margin-bottom: 2px; }
  .watermark { position: relative; }
  .watermark-image { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.08; width: 200px; height: auto; z-index: 0; pointer-events: none; }
</style>

{% assign is_partial = false %}
{% assign is_fully_paid = false %}
{% assign paid_amount = "" %}
{% assign pending_amount = "" %}
{% assign pm_advance = "" %}
{% assign pm_final   = "" %}
{% comment %}Primary: metafields set in Shopify Admin{% endcomment %}
{% if order.metafields.custom.payment_status %}
  {% assign _mf_status = order.metafields.custom.payment_status | downcase %}
  {% if _mf_status == "full"    %}{% assign is_fully_paid = true %}{% endif %}
  {% if _mf_status == "partial" %}{% assign is_partial    = true %}{% endif %}
{% endif %}
{% comment %}is_finalized is a BOOLEAN metafield — compare its string form. Testing the object for
truthiness marks every order fully paid, including the ones explicitly set to false.{% endcomment %}
{% assign _fin = order.metafields.custom.is_finalized.value | default: order.metafields.custom.is_finalized | append: "" | downcase %}
{% if _fin == "true" %}{% assign is_fully_paid = true %}{% endif %}
{% if order.metafields.custom.amount_paid    %}{% assign paid_amount    = order.metafields.custom.amount_paid    | round %}{% endif %}
{% if order.metafields.custom.amount_pending %}{% assign pending_amount = order.metafields.custom.amount_pending | round %}{% endif %}
{% if order.metafields.custom.payment_mode_final   %}{% assign pm_final   = order.metafields.custom.payment_mode_final   %}{% endif %}
{% if order.metafields.custom.payment_mode_advance %}{% assign pm_advance = order.metafields.custom.payment_mode_advance %}{% endif %}
{% comment %}NOTE: a "final payment mode exists ⇒ fully paid" latch used to sit here. With more than
two legs, any second mode flipped a part-paid order to fully paid on a customer-facing invoice.
Paid vs pending is arithmetic — never infer it from a mode.{% endcomment %}
{% comment %}Fallback: tags written by middleware payment flows{% endcomment %}
{% for tag in order.tags %}
  {% assign t = tag | strip | downcase %}
  {% if t == "deposit:partial"    and is_partial == false and is_fully_paid == false %}{% assign is_partial    = true %}{% endif %}
  {% if t == "deposit:fully-paid" and is_partial == false and is_fully_paid == false %}{% assign is_fully_paid = true %}{% endif %}
  {% if t contains "paid:rs"        and paid_amount    == "" %}{% assign paid_amount    = t | remove: "paid:rs"        | strip %}{% endif %}
  {% if t contains "pending:rs"     and pending_amount == "" %}{% assign pending_amount = t | remove: "pending:rs"     | strip %}{% endif %}
{% endfor %}

{% comment %}── Payment installments — up to 4 legs, each date + mode + value ────────────────────
Flat metafields (installment_N_value/_mode/_date) rather than one JSON blob, so staff can type
them in the native editor. Liquid can't index a metafield key dynamically, so each slot is read
explicitly and packed into a delimited string we can loop over once at render time.

A leg whose type is cad_advance is the CAD design advance. It prints as "Design Advance" because
that is what the customer paid for, but it is NOT collected money against this order — custom.advance
already reduces the amount to be collected further down, and counting it here as well would credit
the same rupees twice. installments_collected therefore excludes it.
──{% endcomment %}
{% assign inst_rows = "" %}
{% assign installments_collected = 0 %}
{% for i in (1..4) %}
  {% case i %}
    {% when 1 %}
      {% assign _v = order.metafields.custom.installment_1_value.value | default: order.metafields.custom.installment_1_value | plus: 0 %}
      {% assign _m = order.metafields.custom.installment_1_mode.value  | default: order.metafields.custom.installment_1_mode  | append: "" %}
      {% assign _d = order.metafields.custom.installment_1_date.value  | default: order.metafields.custom.installment_1_date  | append: "" %}
      {% assign _t = order.metafields.custom.installment_1_type.value  | default: order.metafields.custom.installment_1_type  | append: "" %}
    {% when 2 %}
      {% assign _v = order.metafields.custom.installment_2_value.value | default: order.metafields.custom.installment_2_value | plus: 0 %}
      {% assign _m = order.metafields.custom.installment_2_mode.value  | default: order.metafields.custom.installment_2_mode  | append: "" %}
      {% assign _d = order.metafields.custom.installment_2_date.value  | default: order.metafields.custom.installment_2_date  | append: "" %}
      {% assign _t = "" %}
    {% when 3 %}
      {% assign _v = order.metafields.custom.installment_3_value.value | default: order.metafields.custom.installment_3_value | plus: 0 %}
      {% assign _m = order.metafields.custom.installment_3_mode.value  | default: order.metafields.custom.installment_3_mode  | append: "" %}
      {% assign _d = order.metafields.custom.installment_3_date.value  | default: order.metafields.custom.installment_3_date  | append: "" %}
      {% assign _t = "" %}
    {% when 4 %}
      {% assign _v = order.metafields.custom.installment_4_value.value | default: order.metafields.custom.installment_4_value | plus: 0 %}
      {% assign _m = order.metafields.custom.installment_4_mode.value  | default: order.metafields.custom.installment_4_mode  | append: "" %}
      {% assign _d = order.metafields.custom.installment_4_date.value  | default: order.metafields.custom.installment_4_date  | append: "" %}
      {% assign _t = "" %}
  {% endcase %}
  {% if _v > 0 %}
    {% assign inst_rows = inst_rows | append: _d | append: "|" | append: _m | append: "|" | append: _v | append: "|" | append: _t | append: "~" %}
    {% unless _t == "cad_advance" %}{% assign installments_collected = installments_collected | plus: _v %}{% endunless %}
  {% endif %}
{% endfor %}
{% assign inst_list = inst_rows | split: "~" %}
{% assign has_installments = false %}
{% if inst_list.size > 0 %}{% assign has_installments = true %}{% endif %}


{% comment %}── Place of Supply = supplier store state (custom.state_code metafield, e.g. KA-HSR→KA), NOT shipping. Shipping is the delivery destination, used only for the GST inter/intra split. ──{% endcomment %}
{% assign supplier_state = order.metafields.custom.state_code | split: "-" | first | strip | upcase %}
{% if supplier_state == blank %}{% assign supplier_state = "KA" %}{% endif %}
{% assign shipping_state = order.shipping_address.province_code %}
{% assign dest_state = shipping_state %}
{% if dest_state == blank %}{% assign dest_state = supplier_state %}{% endif %}
{% if dest_state == supplier_state %}{% assign is_same_state = true %}{% else %}{% assign is_same_state = false %}{% endif %}
{% assign pos_state = supplier_state %}
{% if pos_state == "JK" %}{% assign state_code = "01" %}{% assign state_name = "Jammu & Kashmir" %}{% elsif pos_state == "HP" %}{% assign state_code = "02" %}{% assign state_name = "Himachal Pradesh" %}{% elsif pos_state == "PB" %}{% assign state_code = "03" %}{% assign state_name = "Punjab" %}{% elsif pos_state == "CH" %}{% assign state_code = "04" %}{% assign state_name = "Chandigarh" %}{% elsif pos_state == "UK" %}{% assign state_code = "05" %}{% assign state_name = "Uttarakhand" %}{% elsif pos_state == "HR" %}{% assign state_code = "06" %}{% assign state_name = "Haryana" %}{% elsif pos_state == "DL" %}{% assign state_code = "07" %}{% assign state_name = "Delhi" %}{% elsif pos_state == "RJ" %}{% assign state_code = "08" %}{% assign state_name = "Rajasthan" %}{% elsif pos_state == "UP" %}{% assign state_code = "09" %}{% assign state_name = "Uttar Pradesh" %}{% elsif pos_state == "BR" %}{% assign state_code = "10" %}{% assign state_name = "Bihar" %}{% elsif pos_state == "SK" %}{% assign state_code = "11" %}{% assign state_name = "Sikkim" %}{% elsif pos_state == "AR" %}{% assign state_code = "12" %}{% assign state_name = "Arunachal Pradesh" %}{% elsif pos_state == "NL" %}{% assign state_code = "13" %}{% assign state_name = "Nagaland" %}{% elsif pos_state == "MN" %}{% assign state_code = "14" %}{% assign state_name = "Manipur" %}{% elsif pos_state == "MZ" %}{% assign state_code = "15" %}{% assign state_name = "Mizoram" %}{% elsif pos_state == "TR" %}{% assign state_code = "16" %}{% assign state_name = "Tripura" %}{% elsif pos_state == "ML" %}{% assign state_code = "17" %}{% assign state_name = "Meghalaya" %}{% elsif pos_state == "AS" %}{% assign state_code = "18" %}{% assign state_name = "Assam" %}{% elsif pos_state == "WB" %}{% assign state_code = "19" %}{% assign state_name = "West Bengal" %}{% elsif pos_state == "JH" %}{% assign state_code = "20" %}{% assign state_name = "Jharkhand" %}{% elsif pos_state == "OR" %}{% assign state_code = "21" %}{% assign state_name = "Odisha" %}{% elsif pos_state == "CT" %}{% assign state_code = "22" %}{% assign state_name = "Chhattisgarh" %}{% elsif pos_state == "MP" %}{% assign state_code = "23" %}{% assign state_name = "Madhya Pradesh" %}{% elsif pos_state == "GJ" %}{% assign state_code = "24" %}{% assign state_name = "Gujarat" %}{% elsif pos_state == "DN" or pos_state == "DD" %}{% assign state_code = "26" %}{% assign state_name = "Dadra & Nagar Haveli and Daman & Diu" %}{% elsif pos_state == "MH" %}{% assign state_code = "27" %}{% assign state_name = "Maharashtra" %}{% elsif pos_state == "KA" %}{% assign state_code = "29" %}{% assign state_name = "Karnataka" %}{% elsif pos_state == "GA" %}{% assign state_code = "30" %}{% assign state_name = "Goa" %}{% elsif pos_state == "LD" %}{% assign state_code = "31" %}{% assign state_name = "Lakshadweep" %}{% elsif pos_state == "KL" %}{% assign state_code = "32" %}{% assign state_name = "Kerala" %}{% elsif pos_state == "TN" %}{% assign state_code = "33" %}{% assign state_name = "Tamil Nadu" %}{% elsif pos_state == "PY" %}{% assign state_code = "34" %}{% assign state_name = "Puducherry" %}{% elsif pos_state == "AN" %}{% assign state_code = "35" %}{% assign state_name = "Andaman & Nicobar Islands" %}{% elsif pos_state == "TG" %}{% assign state_code = "36" %}{% assign state_name = "Telangana" %}{% elsif pos_state == "AP" %}{% assign state_code = "37" %}{% assign state_name = "Andhra Pradesh" %}{% elsif pos_state == "LA" %}{% assign state_code = "38" %}{% assign state_name = "Ladakh" %}{% else %}{% assign state_code = "99" %}{% assign state_name = "Other" %}{% endif %}

<div class="container">

  <div class="header-text">Advance / Proforma Copy</div>

  <div class="title-header">
    <img src="https://cdn.shopify.com/s/files/1/0775/8322/0993/files/Timanti_Logo_Black.jpg?v=1766506323" alt="Timanti Logo" class="logo">
    <div class="title-center"><h1>Order Confirmation &amp; Payment Receipt</h1></div>
  </div>

  <div class="company-invoice-grid">
    <div class="company-section">
      <strong>AURACARAT PRIVATE LIMITED</strong><br>
      <strong>Address:</strong> C207 Crystal Plaza, New Link Road, Andheri (W), Mumbai – 400053 Maharashtra<br>
      <strong>Store Address:</strong> 17th Cross, 19th Main Rd, HSR Layout Sec 2, Opp. Gnan Srishti School, Bengaluru – 560102<br>
      <strong>Tel:</strong> +91-7710938305 &nbsp;|&nbsp; <strong>Email:</strong> hello@timanti.in &nbsp;|&nbsp; <strong>Website:</strong> www.timanti.in<br>
      <strong>GSTIN</strong> – 29ABBCA3309B1Z7 &nbsp;|&nbsp; <strong>PAN</strong> – ABBCA3309B<br>
      <strong>Dispatched From:</strong> 17th Cross, 19th Main Rd, HSR Layout Sec 2, Opp. Gnan Srishti School, Bengaluru – 560102
    </div>

    <div class="invoice-details-grid">
      <div class="invoice-detail-row">
        <div class="invoice-detail-cell">
          <strong>Invoice Number</strong>{{ order.metafields.custom.invoice_number | default: order.name }}
        </div>
        <div class="invoice-detail-cell">
          <strong>Order Number</strong>{{ order.order_number }}
        </div>
        <div class="invoice-detail-cell">
          <strong>Invoice Date</strong>{{ order.created_at | date: "%d/%m/%Y" }}
        </div>
      </div>
      <div class="invoice-detail-row">
        <div class="invoice-detail-cell">
          <strong>Place of Supply</strong>{{ state_code }} – {{ state_name }}
        </div>
        <div class="invoice-detail-cell">
          <strong>Supply Type</strong>B2C
        </div>
        <div class="invoice-detail-cell">
          <strong>Due Date</strong>{{ order.created_at | date: "%d/%m/%Y" }}
        </div>
      </div>
      <div class="invoice-detail-row">
        <div class="invoice-detail-cell" style="grid-column: 1 / -1; font-size: 6px; word-break: break-all;">
          <strong>SKU Code</strong>
          {% for line_item in order.line_items %}{{ line_item.sku }}{% unless forloop.last %}<br>{% endunless %}{% endfor %}
        </div>
      </div>
    </div>
  </div>

  <div class="addresses-section">
    <div class="address-block">
      <strong>Billing Details:</strong>
      {% assign ba = order.billing_address %}
      {% if ba %}
        <div class="address-field"><strong>Customer Name:</strong> {{ ba.first_name | upcase }} {{ ba.last_name | upcase }}</div>
        <div class="address-field"><strong>Address:</strong> {{ ba.address1 }}{% if ba.address2 %}, {{ ba.address2 }}{% endif %}, {{ ba.city }}, {{ ba.province }}{% if ba.zip %} – {{ ba.zip }}{% endif %}, {{ ba.country }}</div>
        <div class="address-field"><strong>Mobile:</strong> {{ ba.phone }}</div>
        <div class="address-field"><strong>Email:</strong> {{ order.email }}</div>
        <div class="address-field"><strong>GSTIN:</strong></div>
        <div class="address-field"><strong>PAN:</strong> {% if order.customer.metafields.custom.pan_number %}{{ order.customer.metafields.custom.pan_number }}{% endif %}</div>
      {% endif %}
    </div>
    <div class="address-block">
      <strong>Shipping Details:</strong>
      {% assign sa = order.shipping_address %}
      {% if sa %}
        <div class="address-field"><strong>Customer Name:</strong> {{ sa.first_name | upcase }} {{ sa.last_name | upcase }}</div>
        <div class="address-field"><strong>Address:</strong> {{ sa.address1 }}{% if sa.address2 %}, {{ sa.address2 }}{% endif %}, {{ sa.city }}, {{ sa.province }}{% if sa.zip %} – {{ sa.zip }}{% endif %}, {{ sa.country }}</div>
        <div class="address-field"><strong>Mobile:</strong> {{ sa.phone }}</div>
        <div class="address-field"><strong>Email:</strong> {{ order.email }}</div>
      {% endif %}
    </div>
  </div>

  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 15%;">Item Description</th>
        <th class="text-center" style="width: 6%;">HSN Code</th>
        <th class="text-center" style="width: 3%;">Qty</th>
        <th class="text-center" style="width: 5%;">Gross Wt (G)</th>
        <th class="text-center" style="width: 5%;">Net Wt (g)</th>
        <th class="text-center" style="width: 5%;">Dia Wt (cts)</th>
        <th class="text-center" style="width: 4%;">Dia Pcs</th>
        <th class="text-center" style="width: 5%;">Col. Stone (Pcs)</th>
        <th class="text-center" style="width: 5%;">Metal</th>
        <th class="text-right" style="width: 9%;">Making Charges</th>
        <th class="text-right" style="width: 9%;">Taxable Val<br>(Before Disc.)</th>
        <th class="text-right" style="width: 8%;">Disc<br>on Taxable</th>
        <th class="text-right" style="width: 9%;">Taxable Value<br>(After Disc.)</th>
      </tr>
    </thead>
    <tbody class="watermark">
      <img src="https://cdn.shopify.com/s/files/1/0775/8322/0993/files/Timanti_Logo_Black.jpg?v=1766506323" alt="Watermark" class="watermark-image">

      {% assign total_gross_paise = 0 %}
      {% assign total_disc_paise  = 0 %}

      {% for line_item in order.line_items %}

        {% comment %}── Pricing properties ──{% endcomment %}
        {% assign prop_discount_str = "0" %}
        {% assign prop_gross_str    = "" %}
        {% assign prop_making_str   = "" %}
        {% for p in line_item.properties %}
          {% if p.first == "Discount Applied" %}{% assign prop_discount_str = p.last | remove: "Rs" | strip %}{% endif %}
          {% if p.first == "Gross Value"       %}{% assign prop_gross_str    = p.last | remove: "Rs" | strip %}{% endif %}
          {% if p.first == "Making Charges" or p.first == "Making" %}{% assign prop_making_str = p.last | remove: "Rs" | strip %}{% endif %}
        {% endfor %}

        {% assign disc_paise = prop_discount_str | times: 100 | round %}
        {% if prop_gross_str != "" %}
          {% assign gross_paise = prop_gross_str | times: 100 | round %}
        {% else %}
          {% assign gross_paise = line_item.final_line_price | plus: disc_paise %}
        {% endif %}
        {% assign total_gross_paise = total_gross_paise | plus: gross_paise %}
        {% assign total_disc_paise  = total_disc_paise  | plus: disc_paise %}

        {% comment %}
          ── Repriced detection ──
          Middleware writes _gross_wt/_net_wt/_diamond_cts/_diamond_pcs as hidden
          line item properties only when delta > 5%. Use those; fall back to variant metafields.
        {% endcomment %}
        {% assign has_repriced_props = false %}
        {% assign prop_gross_wt  = "" %}
        {% assign prop_net_wt    = "" %}
        {% assign prop_dia_cts   = "" %}
        {% assign prop_dia_pcs   = "" %}
        {% assign prop_gem_cts   = "" %}
        {% for p in line_item.properties %}
          {% if p.first == "_gross_wt"     %}{% assign has_repriced_props = true %}{% assign prop_gross_wt = p.last %}{% endif %}
          {% if p.first == "_net_wt"       %}{% assign prop_net_wt    = p.last %}{% endif %}
          {% if p.first == "_diamond_cts"  %}{% assign prop_dia_cts   = p.last %}{% endif %}
          {% if p.first == "_diamond_pcs"  %}{% assign prop_dia_pcs   = p.last %}{% endif %}
          {% if p.first == "_gemstone_cts" %}{% assign prop_gem_cts   = p.last %}{% endif %}
        {% endfor %}

        {% comment %}── Metal from variant title: "18K / YG / 18"" → "18K/YG" ──{% endcomment %}
        {% assign vt_parts = line_item.variant_title | split: " / " %}
        {% assign metal_display = vt_parts[0] | strip %}
        {% if vt_parts[1] %}{% assign metal_display = metal_display | append: "/" | append: vt_parts[1] | strip %}{% endif %}

        <tr>
          <td>{{ line_item.title }}</td>
          <td class="text-center">
            {% if line_item.product.metafields.custom.hsn_code %}{{ line_item.product.metafields.custom.hsn_code }}{% else %}71131914{% endif %}
          </td>
          <td class="text-center">{{ line_item.quantity }}</td>

          {% comment %}── Gross Wt ──{% endcomment %}
          <td class="text-center">
            {% if has_repriced_props and prop_gross_wt != "" %}{{ prop_gross_wt }}
            {% elsif line_item.variant.metafields.custom.total_metal_weight_g %}{{ line_item.variant.metafields.custom.total_metal_weight_g | round: 2 }}
            {% elsif line_item.variant.metafields.custom.gross_weight_g %}{{ line_item.variant.metafields.custom.gross_weight_g | round: 2 }}
            {% elsif line_item.product.metafields.custom.total_metal_weight_g %}{{ line_item.product.metafields.custom.total_metal_weight_g | round: 2 }}
            {% else %}–{% endif %}
          </td>

          {% comment %}── Net Wt ──{% endcomment %}
          <td class="text-center">
            {% if has_repriced_props and prop_net_wt != "" %}{{ prop_net_wt }}
            {% elsif line_item.variant.metafields.custom.net_metal_weight_g %}{{ line_item.variant.metafields.custom.net_metal_weight_g | round: 2 }}
            {% elsif line_item.product.metafields.custom.net_metal_weight_g %}{{ line_item.product.metafields.custom.net_metal_weight_g | round: 2 }}
            {% else %}–{% endif %}
          </td>

          {% comment %}── Dia Wt (cts) ──{% endcomment %}
          <td class="text-center">
            {% if prop_dia_cts != "" %}{{ prop_dia_cts }}
            {% elsif line_item.product.metafields.custom.totaldiamondweight %}{{ line_item.product.metafields.custom.totaldiamondweight }}
            {% elsif line_item.variant.metafields.custom.totaldiamondweight %}{{ line_item.variant.metafields.custom.totaldiamondweight }}
            {% else %}–{% endif %}
          </td>

          {% comment %}── Dia Pcs ──{% endcomment %}
          <td class="text-center">
            {% if prop_dia_pcs != "" %}{{ prop_dia_pcs }}
            {% elsif line_item.product.metafields.custom.diamond_pcs %}{{ line_item.product.metafields.custom.diamond_pcs }}
            {% elsif line_item.variant.metafields.custom.diamond_pcs %}{{ line_item.variant.metafields.custom.diamond_pcs }}
            {% else %}–{% endif %}
          </td>

          {% comment %}── Col. Stone Pcs + gemstone cts if set ──{% endcomment %}
          <td class="text-center">
            {% assign stone_pcs = "" %}
            {% if line_item.product.metafields.custom.coloured_stone_pcs %}{% assign stone_pcs = line_item.product.metafields.custom.coloured_stone_pcs %}
            {% elsif line_item.variant.metafields.custom.coloured_stone_pcs %}{% assign stone_pcs = line_item.variant.metafields.custom.coloured_stone_pcs %}
            {% endif %}
            {% if stone_pcs != "" %}{{ stone_pcs }} pcs{% if prop_gem_cts != "" and prop_gem_cts != "0.00" %} / {{ prop_gem_cts }} cts{% endif %}
            {% elsif prop_gem_cts != "" and prop_gem_cts != "0.00" %}{{ prop_gem_cts }} cts
            {% else %}–{% endif %}
          </td>

          <td class="text-center">{{ metal_display | default: "–" }}</td>

          {% comment %}── Making Charges (component value, pre-GST) ──{% endcomment %}
          <td class="text-right">
            {% if prop_making_str != "" %}₹{{ prop_making_str | times: 100 | round | money_without_currency | remove: ',' }}
          {% elsif line_item.variant.metafields.custom.price_breakup_making %}₹{{ line_item.variant.metafields.custom.price_breakup_making | times: line_item.quantity | times: 100 | round | money_without_currency | remove: ',' }}
          {% else %}–{% endif %}
          </td>

          <td class="text-right">₹{{ gross_paise | divided_by: 1.03 | money_without_currency | remove: ',' }}</td>
          {% comment %}Discount Applied is PRE-TAX (diamond/making component discount) — show as-is, no ÷1.03.{% endcomment %}
          <td class="text-right">₹{{ disc_paise | money_without_currency | remove: ',' }}</td>
          <td class="text-right">₹{{ gross_paise | divided_by: 1.03 | minus: disc_paise | money_without_currency | remove: ',' }}</td>
        </tr>
      {% endfor %}

      {% comment %}── Credit note ──{% endcomment %}
      {% assign cn_applied = false %}
      {% assign cn_code    = "" %}
      {% assign cn_amount  = 0 %}
      {% for discount in order.cart_level_discount_applications %}
        {% if discount.code contains "CNTM" %}{% assign cn_applied = true %}{% assign cn_code = discount.code %}{% assign cn_amount = discount.total_allocated_amount %}{% endif %}
      {% endfor %}
      {% unless cn_applied %}
        {% for discount in order.discount_applications %}
          {% if discount.code contains "CNTM" %}{% assign cn_applied = true %}{% assign cn_code = discount.code %}{% assign cn_amount = discount.total_allocated_amount %}{% endif %}
        {% endfor %}
      {% endunless %}

      {% if cn_applied %}
      <tr class="totals-row">
        <td colspan="12" class="text-right" style="color:#006630; font-style:italic;">Credit Note Applied &nbsp;({{ cn_code }})</td>
        <td class="text-right" style="color:#006630; font-weight:bold;">− ₹{{ cn_amount | money_without_currency | remove: ',' }}</td>
      </tr>
      {% endif %}

      {% comment %}Discount Applied is PRE-TAX, so it reduces the tax-inclusive Total by disc×1.03 (its GST
      comes off too), NOT by the raw disc. A native Credit Note (cn_amount, read raw from Shopify) IS
      tax-inclusive, subtracted as-is. taxable_base stays the tax-inclusive Total; taxable_value =
      taxable_base/1.03 downstream.{% endcomment %}
      {% assign disc_incl_paise = total_disc_paise | times: 1.03 %}
      {% assign taxable_base = total_gross_paise | minus: disc_incl_paise %}
      {% if cn_applied %}{% assign taxable_base = taxable_base | minus: cn_amount %}{% endif %}

      {% comment %}── Old gold exchange ──{% endcomment %}
      {% assign og_value  = order.metafields.custom.old_gold_value  | plus: 0 %}
      {% assign og_weight = order.metafields.custom.old_gold_weight | plus: 0 %}
      {% assign og_karat  = order.metafields.custom.old_gold_karat  | default: "" %}
      {% for attr in order.note_attributes %}
        {% if attr.name == "old_gold_value"  and og_value  == 0 %}{% assign og_value  = attr.value | plus: 0 %}{% endif %}
        {% if attr.name == "old_gold_weight" and og_weight == 0 %}{% assign og_weight = attr.value | plus: 0 %}{% endif %}
        {% if attr.name == "old_gold_karat"  and og_karat  == "" %}{% assign og_karat  = attr.value %}{% endif %}
      {% endfor %}
      {% if og_value > 0 %}
        {% assign og_value_paise = og_value | times: 100 | round %}
        {% assign og_gross_paise = og_value | times: 103 | round %}
        {% assign taxable_base   = taxable_base | minus: og_gross_paise %}
      {% endif %}

      {% assign taxable_value = taxable_base | divided_by: 1.03 %}
      {% assign gst_computed  = taxable_value | times: 0.03 %}
      {% assign round_off     = taxable_base | minus: taxable_value | minus: gst_computed %}

      <tr class="totals-row">
        <td colspan="12" class="text-right"><strong>Taxable Value</strong></td>
        <td class="text-right"><strong>₹{{ taxable_value | money_without_currency | remove: ',' }}</strong></td>
      </tr>

      {% if is_same_state %}
        {% assign cgst_amount = taxable_value | times: 0.015 %}
        {% assign sgst_amount = taxable_value | times: 0.015 %}
        <tr class="totals-row"><td colspan="12" class="text-right">IGST @ 3%</td><td class="text-right">–</td></tr>
        <tr class="totals-row"><td colspan="12" class="text-right">CGST @ 1.5%</td><td class="text-right">₹{{ cgst_amount | money_without_currency | remove: ',' }}</td></tr>
        <tr class="totals-row"><td colspan="12" class="text-right">SGST @ 1.5%</td><td class="text-right">₹{{ sgst_amount | money_without_currency | remove: ',' }}</td></tr>
      {% else %}
        {% assign igst_amount = taxable_value | times: 0.03 %}
        <tr class="totals-row"><td colspan="12" class="text-right">IGST @ 3%</td><td class="text-right">₹{{ igst_amount | money_without_currency | remove: ',' }}</td></tr>
        <tr class="totals-row"><td colspan="12" class="text-right">CGST @ 1.5%</td><td class="text-right">–</td></tr>
        <tr class="totals-row"><td colspan="12" class="text-right">SGST @ 1.5%</td><td class="text-right">–</td></tr>
      {% endif %}

      <tr class="totals-row">
        <td colspan="12" class="text-right">Round Off +/(-)</td>
        <td class="text-right">₹{{ round_off | money_without_currency | remove: ',' }}</td>
      </tr>
      <tr class="total-row">
        <td colspan="12" class="text-right">Total Invoice Price</td>
        <td class="text-right">₹{{ taxable_base | money_without_currency | remove: ',' }}</td>
      </tr>

      {% if og_value > 0 %}
      <tr class="totals-row">
        <td colspan="12" class="text-right">Consideration against Gold received ({{ og_weight }}g{% if og_karat != "" %}, {{ og_karat }}kt{% endif %})</td>
        <td class="text-right">₹{{ og_value_paise | money_without_currency | remove: ',' }}</td>
      </tr>
      {% endif %}

      {% comment %}── Payment rows. Preferred: the installment table (one row per leg, date + mode
      + value). Fallback: the legacy single-line view, kept because Order Printer can return empty
      metafields at print time, and for orders that predate the installment migration. ──{% endcomment %}
      {% if has_installments %}
        {% for row in inst_list %}
          {% assign c = row | split: "|" %}
          {% assign c_date = c[0] %}
          {% assign c_mode = c[1] %}
          {% assign c_val  = c[2] %}
          {% assign c_type = c[3] %}
          <tr class="totals-row">
            <td colspan="12" class="text-right"{% if forloop.first %} style="border-top: 1px solid #ccc;"{% endif %}>
              {% if c_type == "cad_advance" %}Design Advance{% else %}Amount Received{% endif %}
              {% if c_date != "" %}&nbsp;<em style="color:#555;">{{ c_date | date: "%d %b %Y" }}</em>{% endif %}
              {% if c_mode != "" %}&nbsp;<em style="color:#555;">({{ c_mode }})</em>{% endif %}
            </td>
            <td class="text-right"{% if forloop.first %} style="border-top: 1px solid #ccc;"{% endif %}>₹{{ c_val | round }}</td>
          </tr>
        {% endfor %}
        <tr class="totals-row">
          <td colspan="12" class="text-right"><strong>Balance Due</strong></td>
          <td class="text-right"><strong>{% if pending_amount != "" %}₹{{ pending_amount }}{% else %}₹0{% endif %}</strong></td>
        </tr>
      {% elsif is_partial and paid_amount != "" %}
        <tr class="totals-row">
          <td colspan="12" class="text-right">
            Amount Received – Advance{% if pm_advance != "" %}&nbsp; <em style="color:#555;">({{ pm_advance }})</em>{% endif %}
          </td>
          <td class="text-right">₹{{ paid_amount }}</td>
        </tr>
        <tr class="totals-row">
          <td colspan="12" class="text-right"><strong>Balance Due</strong></td>
          <td class="text-right"><strong>₹{{ pending_amount }}</strong></td>
        </tr>
      {% elsif is_fully_paid %}
        {% assign pm_display = "" %}
        {% if pm_advance != "" and pm_final != "" and pm_final != pm_advance %}
          {% assign pm_display = pm_advance | append: " / " | append: pm_final %}
        {% elsif pm_advance != "" %}
          {% assign pm_display = pm_advance %}
        {% elsif pm_final != "" %}
          {% assign pm_display = pm_final %}
        {% endif %}
        <tr class="totals-row">
          <td colspan="12" class="text-right">
            Amount Received{% if pm_display != "" %}&nbsp; <em style="color:#555;">({{ pm_display }})</em>{% endif %}
          </td>
          <td class="text-right">{% if paid_amount != "" %}₹{{ paid_amount }}{% else %}₹{{ taxable_base | money_without_currency | remove: ',' }}{% endif %}</td>
        </tr>
        <tr class="totals-row">
          <td colspan="12" class="text-right"><strong>Balance Due</strong></td>
          <td class="text-right"><strong>₹0</strong></td>
        </tr>
      {% else %}
        <tr class="totals-row">
          <td colspan="12" class="text-right">Amount Received</td>
          <td class="text-right">₹0</td>
        </tr>
        <tr class="totals-row">
          <td colspan="12" class="text-right"><strong>Balance Due</strong></td>
          <td class="text-right"><strong>₹{{ taxable_base | money_without_currency | remove: ',' }}</strong></td>
        </tr>
      {% endif %}

    </tbody>
  </table>

  <div class="amount-words">
    <span>
      {% assign ones = "Zero,One,Two,Three,Four,Five,Six,Seven,Eight,Nine,Ten,Eleven,Twelve,Thirteen,Fourteen,Fifteen,Sixteen,Seventeen,Eighteen,Nineteen" | split: "," %}
      {% assign tens = "Zero,Ten,Twenty,Thirty,Forty,Fifty,Sixty,Seventy,Eighty,Ninety" | split: "," %}
      {% assign total_int = taxable_base | divided_by: 100 | floor %}
      {% assign words = "" %}
      {% assign crores = total_int | divided_by: 10000000 %}
      {% if crores > 0 %}{% assign temp = crores | modulo: 100 %}{% if temp < 20 %}{% assign words = words | append: ones[temp] | append: " " %}{% else %}{% assign td = temp | divided_by: 10 %}{% assign od = temp | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% assign words = words | append: " " %}{% endif %}{% assign words = words | append: "Crore " %}{% assign total_int = total_int | modulo: 10000000 %}{% endif %}
      {% assign lakhs = total_int | divided_by: 100000 %}
      {% if lakhs > 0 %}{% assign temp = lakhs | modulo: 100 %}{% if temp < 20 %}{% assign words = words | append: ones[temp] | append: " " %}{% else %}{% assign td = temp | divided_by: 10 %}{% assign od = temp | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% assign words = words | append: " " %}{% endif %}{% assign words = words | append: "Lakh " %}{% assign total_int = total_int | modulo: 100000 %}{% endif %}
      {% assign thousands = total_int | divided_by: 1000 %}
      {% if thousands > 0 %}{% assign temp = thousands | modulo: 100 %}{% if temp < 20 %}{% assign words = words | append: ones[temp] | append: " " %}{% else %}{% assign td = temp | divided_by: 10 %}{% assign od = temp | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% assign words = words | append: " " %}{% endif %}{% assign words = words | append: "Thousand " %}{% assign total_int = total_int | modulo: 1000 %}{% endif %}
      {% assign hundreds = total_int | divided_by: 100 %}{% if hundreds > 0 %}{% assign words = words | append: ones[hundreds] | append: " Hundred " %}{% assign total_int = total_int | modulo: 100 %}{% endif %}
      {% if total_int > 0 %}{% if total_int < 20 %}{% assign words = words | append: ones[total_int] %}{% else %}{% assign td = total_int | divided_by: 10 %}{% assign od = total_int | modulo: 10 %}{% assign words = words | append: tens[td] %}{% if od > 0 %}{% assign words = words | append: "-" | append: ones[od] %}{% endif %}{% endif %}{% endif %}
      Amount in Words: Rupees {{ words }} Only
    </span>
    <span>E. &amp; O. E.</span>
  </div>

  <div style="padding: 4px 8px; font-size: 7px; color: #555; border-top: 1px solid #ccc; text-align: right;">
    {% assign rate_18k = "" %}
    {% assign rate_14k = "" %}
    {% assign gold_updated = "" %}
    {% for line_item in order.line_items %}
      {% assign sku_parts = line_item.variant.sku | split: "|" %}
      {% assign karat = sku_parts[2] | strip %}
      {% assign locked_rate = "" %}
      {% assign locked_ts   = "" %}
      {% for p in line_item.properties %}
        {% if p.first == "_gold_rate"       %}{% assign locked_rate = p.last %}{% endif %}
        {% if p.first == "_gold_updated_at" %}{% assign locked_ts   = p.last %}{% endif %}
      {% endfor %}
      {% if karat == "18" and rate_18k == "" and locked_rate != "" %}{% assign rate_18k = locked_rate %}{% if locked_ts != "" %}{% assign gold_updated = locked_ts %}{% endif %}{% endif %}
      {% if karat == "14" and rate_14k == "" and locked_rate != "" %}{% assign rate_14k = locked_rate %}{% if gold_updated == "" and locked_ts != "" %}{% assign gold_updated = locked_ts %}{% endif %}{% endif %}
    {% endfor %}
    {% if rate_18k == "" and rate_14k != "" %}{% assign rate_18k = rate_14k | plus: 0 | times: 0.771 | divided_by: 0.604 | round: 2 %}{% endif %}
    {% if rate_14k == "" and rate_18k != "" %}{% assign rate_14k = rate_18k | plus: 0 | times: 0.604 | divided_by: 0.771 | round: 2 %}{% endif %}
    Gold rate — 18kt: Rs {{ rate_18k }} &nbsp;|&nbsp; 14kt: Rs {{ rate_14k }}{% if gold_updated != "" %}{% assign ist_ts = gold_updated | date: "%s" | plus: 19800 %} &nbsp;(as of {{ ist_ts | date: "%d %b %Y" }} IST){% endif %}
  </div>

