<div hidden data-tl-config
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-login-url="{{ routes.account_login_url }}?return_url={{ routes.cart_url | url_encode }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-logged-out-text="{{ block.settings.logged_out_text | escape }}"></div>

<script src="{{ 'loyalty-benefits.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'loyalty-benefits.css' | asset_url }}">

{% schema %}
{
  "name": "My benefits (cart drawer)",
  "target": "body",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My benefits" },
    { "type": "text", "id": "logged_out_text", "label": "Text when logged out", "default": "Log in to see your loyalty benefit and vouchers." }
  ]
}
{% endschema %}
