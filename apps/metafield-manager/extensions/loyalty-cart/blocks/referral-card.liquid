<div class="tl-ref" data-tl-referral
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-login-url="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-intro="{{ block.settings.intro | escape }}"
  data-share-text="{{ block.settings.share_text | escape }}">
  <h2 class="tl-ref__title">{{ block.settings.heading | escape }}</h2>
  <div class="tl-ref__body"><p class="tl-ref__muted">Loading your referral link…</p></div>
</div>

<script src="{{ 'referral-card.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'referral-card.css' | asset_url }}">

{% schema %}
{
  "name": "Refer a friend",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Refer a friend" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Share your link. When a friend makes their first Timanti purchase, you get [pct]% off the diamond value of your next piece." },
    { "type": "textarea", "id": "share_text", "label": "WhatsApp message", "default": "I love my Timanti diamonds. Take a look: [link]" }
  ]
}
{% endschema %}
